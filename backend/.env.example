# MongoDB database name can be supplied here or included in MONGODB_URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/product_recommendation_system?retryWrites=true&w=majority
MONGODB_DB_NAME=product_recommendation_system
JWT_SECRET_KEY=generate-a-long-random-secret
SECRET_KEY=generate-a-different-long-random-secret
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=https://your-frontend-domain.example
